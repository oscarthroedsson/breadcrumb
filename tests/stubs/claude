#!/usr/bin/env python3
"""Stand-in for the claude CLI, so eval/run.sh can be tested without API calls.

Behaviour is chosen by the STUB_MODE environment variable:
  ok       — answers preflight, investigator and executor prompts
  noauth   — always returns the unauthenticated error
"""
import json, os, sys

argv = sys.argv[1:]
prompt = ""
for i, a in enumerate(argv):
    if a in ("-p", "--print") and i + 1 < len(argv):
        prompt = argv[i + 1]
        break

mode = os.environ.get("STUB_MODE", "ok")

if mode == "noauth":
    out = {"result": "Invalid API key · Please run /login",
           "is_error": True, "total_cost_usd": 0,
           "usage": {"output_tokens": 0}}
elif prompt.strip() == "ping":
    out = {"result": "PONG", "total_cost_usd": 0.0001,
           "usage": {"output_tokens": 3}}
elif "<report>" in prompt:
    out = {"result": "VERDICT: NOT_SAFE\nREASON: the root cause is unconfirmed.",
           "total_cost_usd": 0.0002, "usage": {"output_tokens": 14}}
else:
    out = {"result": "JWT_SECRET is probably missing in CI. Unconfirmed.",
           "total_cost_usd": 0.0003, "usage": {"output_tokens": 42}}

print(json.dumps(out))
